# Copy to .env.local (npm run demo:setup does this) and fill in. Everything is optional: without keys the demo
# runs on clearly labelled simulated AI and the in-browser WhatsApp simulator.

# ---------- Text + photo AI (listing extraction, photo ripeness/defects, cancellation intent) ----------
# Anthropic is used when its key is set; otherwise DeepSeek through its Anthropic-compatible API.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash      # deepseek-flash reads photos; deepseek-v4-pro does not
# AI_PROVIDER=                       # anthropic | deepseek (default: whichever key is set, Anthropic first)

# ---------- ElevenLabs Scribe v2: Azerbaijani speech-to-text ----------
# Easiest: npx -y @elevenlabs/cli@latest onboard init   (signs in and writes the key here)
ELEVENLABS_API_KEY=

# ---------- Voice replies (ElevenLabs text-to-speech) ----------
# The assistant also answers every message with an Azerbaijani voice note. V in the app toggles it.
# TTS_REPLIES=1
# TTS_VOICE_ID=BQgh92MxG7QAtCA8wY7O   # "Ibrahim Mammadli", native Azerbaijani, from the ElevenLabs voice library
# TTS_MODEL=eleven_v4_turbo           # half the credits of eleven_v4

# ---------- AI mode ----------
# live       real provider calls; on failure, a cached verified result, then the scripted fallback
# cached     only previously verified results (no network), else scripted
# simulated  scripted only
# Switch at any time with F in the app or: npm run demo:mode -- --ai=cached
AI_MODE=live
# AI_TIMEOUT_MS=25000

# ---------- Twilio WhatsApp sandbox (Console > Messaging > Try it out > Send a WhatsApp message) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# simulator (docked phone) or twilio (real phones). Switch with W or: npm run demo:mode -- --whatsapp=twilio
WHATSAPP_CHANNEL=simulator
# Map each teammate's phone to a demo farmer (E.164, no spaces). Only these numbers are accepted.
FARMER_PHONES=f-elsen=+99450XXXXXXX,f-rauf=+99455XXXXXXX,f-sebine=+99470XXXXXXX,f-gulnare=+99451XXXXXXX
# PUBLIC_BASE_URL=https://your-tunnel.example   # normally written by npm run demo:tunnel
# TWILIO_VALIDATE_SIGNATURE=1                   # never disable for a public tunnel

# ---------- Access control ----------
# Required when the app is reachable through a tunnel. demo:setup generates it.
# Remote browsers open https://<tunnel>/?key=<token> once; localhost needs nothing.
DEMO_ADMIN_TOKEN=

# ---------- Demo timeline and pacing ----------
# The demo day in Baku. Default: today. The story starts at 14:00 that day and delivers at 09:00 the next morning.
# DEMO_DATE=2026-11-10
# DEMO_STEP_MS=750        # minimum time per AI step on the Intake screen
# DEMO_RECOVERY_MS=1800   # how long "re-matching" shows before the backup appears
# DEMO_RESTORE=1          # restore the last state after a server restart (demo:launch starts fresh unless --resume)
