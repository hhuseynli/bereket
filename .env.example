# Copy to .env.local and fill in. Everything is optional: without keys the demo runs on scripted AI.

# Claude: listing extraction, photo inspection, intent detection
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# ElevenLabs Scribe v2: Azerbaijani speech-to-text
ELEVENLABS_API_KEY=

# Twilio WhatsApp sandbox (Console > Messaging > Try it out > Send a WhatsApp message)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Start with WhatsApp live instead of the simulator (or press W in the app)
WHATSAPP_CHANNEL=simulator
# Map each teammate's phone to a demo farmer (E.164, no spaces)
FARMER_PHONES=f-elsen=+99450XXXXXXX,f-rauf=+99455XXXXXXX,f-sebine=+99470XXXXXXX,f-gulnare=+99451XXXXXXX

# Demo pacing
# DEMO_STEP_MS=750        # minimum time per AI step on the Intake screen
# DEMO_RECOVERY_MS=1800   # how long "re-matching" shows before the backup appears
# AI_OFFLINE=1            # start in offline AI mode (press F to toggle)
